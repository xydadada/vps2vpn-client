+// Selection is shared by control requests and both traffic and status readers.
+// Do not hold this lock across a health probe or network operation.
+func (f *Fallback) selectedName() string {
+	f.selectedMu.RLock()
+	defer f.selectedMu.RUnlock()
+	return f.selected
+}
+
+func (f *Fallback) setSelected(name string) {
+	f.selectedMu.Lock()
+	f.selected = name
+	f.selectedMu.Unlock()
+}
+
+func (f *Fallback) clearSelectedIf(name string) {
+	f.selectedMu.Lock()
+	if f.selected == name {
+		f.selected = ""
+	}
+	f.selectedMu.Unlock()
+}

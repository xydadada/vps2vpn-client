get_directory_property(_FLCLASH_FLUTTER_ROOT
  DIRECTORY "${FLUTTER_MANAGED_DIR}" DEFINITION FLUTTER_ROOT)
get_directory_property(_FLCLASH_TOOL_ENVIRONMENT
  DIRECTORY "${FLUTTER_MANAGED_DIR}" DEFINITION FLUTTER_TOOL_ENVIRONMENT)

set(_FLCLASH_DART_DEFINES "")
foreach(_FLCLASH_ENV_ENTRY IN LISTS _FLCLASH_TOOL_ENVIRONMENT)
  if(_FLCLASH_ENV_ENTRY MATCHES "^DART_DEFINES=")
    string(SUBSTRING "${_FLCLASH_ENV_ENTRY}" 13 -1 _FLCLASH_DART_DEFINES)
  endif()
endforeach()

set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
  "${CMAKE_CURRENT_LIST_DIR}/../../tool/windows_safe_mode.dart")
execute_process(
  COMMAND "${_FLCLASH_FLUTTER_ROOT}/bin/cache/dart-sdk/bin/dart${CMAKE_EXECUTABLE_SUFFIX}"
    "${CMAKE_CURRENT_LIST_DIR}/../../tool/windows_safe_mode.dart"
    "${_FLCLASH_DART_DEFINES}"
  RESULT_VARIABLE _FLCLASH_SAFE_MODE_RESULT
  OUTPUT_VARIABLE FLCLASH_SAFE_MODE
  ERROR_VARIABLE _FLCLASH_SAFE_MODE_ERROR
  OUTPUT_STRIP_TRAILING_WHITESPACE
)
if(NOT _FLCLASH_SAFE_MODE_RESULT STREQUAL "0" OR
   NOT FLCLASH_SAFE_MODE MATCHES "^[01]$")
  message(FATAL_ERROR "Cannot resolve native SAFE_MODE from Flutter DART_DEFINES.")
endif()
